rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uapStudent() {
      return signedIn() && request.auth.token.email is string &&
             request.auth.token.email.matches('.*@uap-bd\\.edu$');
    }
    function admin() {
      return signedIn() && request.auth.token.email in [
        'threevondo@gmail.com',
        '24201147@uap-bd.edu',
        'abdullahusama204@gmail.com',
        '24201154@uap-bd.edu',
        'afrindiya345@gmail.com',
        '24201165@uap-bd.edu',
        'avidbnth@gmail.com'
      ];
    }

    match /questions/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /notes/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /gallery/{id} {
      allow read: if uapStudent() || admin();
      allow create, update, delete: if admin();
    }

    match /submissions/{id} {
      allow create: if uapStudent() &&
        request.resource.data.submittedBy == request.auth.token.email &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if admin();
    }

    match /reports/{id} {
      allow create: if request.resource.data.email is string &&
        request.resource.data.type is string &&
        request.resource.data.page is string &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0;
      allow read, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
